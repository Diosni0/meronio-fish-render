# Obligatorias (se ponen en Render → Environment, nunca en git)
FISH_API_KEY=tu_api_key_de_fish_audio
FISH_VOICE_ID=tu_voice_id

# Opcional
FISH_MODEL=s2.1-pro-free
# Si se deja vacío, el servidor deduce la URL pública de la petición.
PUBLIC_BASE_URL=
